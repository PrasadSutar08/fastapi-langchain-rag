ENVIRONMENT=development
DEBUG=false
TESTING=false
AUTO_CREATE_TABLES=true

SECRET_KEY_ACCESS_API=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-this-password

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=postgres
DB_PASS=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_ENABLED=true
QA_RATE_LIMIT=20
QA_RATE_LIMIT_WINDOW_SECONDS=60
SEARCH_RATE_LIMIT=60
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_SIZE=52428800
ALLOWED_DOCUMENT_TYPES=application/pdf

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
VECTOR_COLLECTION_NAME=docs
RETRIEVAL_TOP_K=4
RETRIEVAL_FETCH_K=20
RETRIEVAL_SEARCH_TYPE=mmr
RETRIEVAL_MMR_LAMBDA=0.65
RETRIEVAL_KEYWORD_WEIGHT=0.15
RETRIEVAL_RELEVANCE_THRESHOLD=0.20
CHUNK_SIZE=900
CHUNK_OVERLAP=120
MAX_CONTEXT_CHARS=9000
MAX_HISTORY_MESSAGES=4
MAX_CONTEXT_DOCUMENTS=4

# LLM_PROVIDER selects which backend answers questions:
#   ollama (default) -- self-hosted local inference. Use this for
#     local development, or if you're running this project
#     open-source against your own GPU/machine.
#   groq -- hosted inference via Groq's free API (no credit card,
#     generous free tier, sub-second responses). Used for the
#     publicly deployed demo so it stays fast and always-on without
#     needing a self-hosted GPU/VM. Get a free key at
#     https://console.groq.com/keys
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0
OLLAMA_MAX_TOKENS=512
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_THREAD=6
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_CONCURRENCY=1

# Only used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
LOGGING_LEVEL=INFO

# Optional: LangSmith tracing (leave LANGSMITH_API_KEY blank to disable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag-api
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
